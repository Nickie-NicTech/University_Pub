DJANGO_SECRET_KEY=replace-with-a-random-secret-key
UNIPUB_ADMIN_USERNAME=admin
UNIPUB_ADMIN_PASSWORD=replace-with-a-strong-password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-your-smtp-user
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=UNIPUB <noreply@example.com>
APPS_SCRIPT_MAIL_ENDPOINT=https://script.google.com/macros/s/replace-with-deployment-id/exec
APPS_SCRIPT_MAIL_API_KEY=replace-with-a-long-random-secret
APPS_SCRIPT_MAIL_TIMEOUT=20
